# ---- Gmail SMTP ----
# 1) Enable 2-Step Verification on your Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Paste the 16-char app password below (NOT your normal Gmail password)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER= <your.email@gmail.com>
SMTP_PASS= <16-char-app-password>
MAIL_FROM="Scheme Notifier <your.email@gmail.com>"

# Server
PORT=4000

# Cron schedule (default: every day at 09:00)
CRON_SCHEDULE=0 9 * * *

# Notify when a scheme deadline is within N days
REMIND_WITHIN_DAYS=7
